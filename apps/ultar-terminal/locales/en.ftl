# ultar-terminal – texts of the terminal (Arabic is the reference)
app.terminal.name = Terminal
app.terminal.desc = Arabic and English commands for your files and the system's programs.
term.output = Terminal output
term.command = Command
term.run = Run
term.stop = Stop
term.welcome = Ultar terminal – type help (or مساعدة) for the commands.
term.help.title = Commands (Arabic or English):
term.help.ls = ls | اعرض [folder]          what a folder holds
term.help.cd = cd | انتقل [folder]         go to a folder (~ is home)
term.help.pwd = pwd | أين                  the current folder
term.help.cat = cat | اقرأ file            show a text file
term.help.echo = echo | اطبع text          print text
term.help.mkdir = mkdir | أنشئ folder      a new folder
term.help.rm = rm | احذف [-r] path         delete a file (a folder with -r)
term.help.cp = cp | انسخ from to           copy a file or folder
term.help.mv = mv | انقل from to           move or rename
term.help.clear = clear | امسح             clear the screen
term.help.date = date | التاريخ            date and time (UTC)
term.help.whoami = whoami | من             the user
term.help.uname = uname | النظام           system name and version
term.help.history = history | السجل        earlier commands
term.help.env = env | بيئة                 environment variables
term.help.exit = exit | خروج               close the terminal
term.help.programs = Any program of the system by its name too, like ulog. Ctrl+C stops it.
term.unknown = Unknown command: “{name}”. Type help.
term.missing = Not found: {path}
term.denied = Not allowed: {path}
term.exists = Already exists: {path}
term.not_dir = Not a folder: {path}
term.is_dir = A folder (use -r): {path}
term.not_empty = The folder is not empty: {path}
term.failed = Failed: {path} ({reason})
term.usage = Usage: {usage}
term.binary = {path}: a binary file, not shown as text
term.exit_code = The program ended with code {code}
term.start_failed = Couldn’t start “{name}”: {reason}
term.stopped = The program was stopped
term.busy = A program is running; Ctrl+C stops it.
term.empty = (empty)
