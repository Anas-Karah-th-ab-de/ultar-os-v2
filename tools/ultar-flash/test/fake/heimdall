#!/bin/bash
# TEST-ATTRAPPE für heimdall (Samsung-Download-Modus).
D=${FAKE_DEV:?}; state=$(cat "$D/state" 2>/dev/null || echo adb)
case "$1" in
  version) echo "v1.4.2 (Attrappe)";;
  detect) [ "$state" = download ] && echo "Device detected" || { echo "ERROR: Failed to detect compatible download-mode device." >&2; exit 1; };;
  print-pit) [ "$state" = download ] || exit 1; for n in BOOTLOADER PIT EFS BOOT RECOVERY VBMETA SYSTEM VENDOR USERDATA; do printf -- '--- Entry ---\nPartition Name: %s\n' $n; done;;
  flash) [ "$state" = download ] || exit 1; shift; while [ $# -gt 0 ]; do case "$1" in --resume|--no-reboot) shift;; --*) n=$(echo "${1#--}" | tr A-Z a-z); cp "$2" "$D/dev/block/by-name/$n"; echo "$n upload successful"; shift 2;; *) shift;; esac; done; echo adb > "$D/state";;
esac
