# Apps that tools/release/build-apps.sh packs and publishes into the store.
# crate              binary             features  key     (system = app.system profile, store = app.standard)
ultar-store          ultar-store        gui       system
ultar-settings       ultar-settings     -         system
ultar-files          ultar-files        -         system
ultar-appbuilder     ultar-appbuilder   gui       store
ultar-editor         ultar-editor       -         system
ultar-sheet          ultar-sheet        -         system
ultar-terminal       ultar-terminal     -         system
