app.appbuilder.name = App-Builder
app.appbuilder.desc = Ein App-Projekt prüfen, als mit dem eigenen Schlüssel signiertes .uap verpacken und zum Testen auf diesem Gerät installieren.
appbuilder.project = Projektordner
appbuilder.check = Prüfen
appbuilder.build = Paket bauen
appbuilder.install = Zum Testen installieren
appbuilder.state.idle = Wählen Sie einen Projektordner mit ultar-app.toml und einem Ordner payload.
appbuilder.state.busy = Wird bearbeitet …
appbuilder.state.checked = Projekt ist in Ordnung: { $id } { $version }
appbuilder.state.built = Fertig: { $path }
appbuilder.state.installed = { $id } wurde auf diesem Gerät installiert.
appbuilder.key.title = Entwicklerschlüssel
appbuilder.key.id = Schlüsselkennung: { $id }
appbuilder.key.public = Öffentlicher Schlüssel: { $key }
appbuilder.key.trust = Damit dieses Gerät Ihre Pakete annimmt, muss ein Administrator diesen öffentlichen Schlüssel als { $file } zu den vertrauenswürdigen Schlüsseln hinzufügen.
appbuilder.issue.no-manifest = Im Ordner gibt es keine ultar-app.toml.
appbuilder.issue.manifest-damaged = Das Manifest ist nicht lesbar (ungültiges TOML).
appbuilder.issue.bad-id = Die Kennung muss <Herausgeber>.<App> aus kleinen lateinischen Buchstaben, Ziffern und Bindestrichen sein; der Herausgeber muss dem Feld publisher entsprechen.
appbuilder.issue.bad-version = Die Version muss wie 1.2.3 aussehen.
appbuilder.issue.no-publisher = Das Feld publisher fehlt.
appbuilder.issue.bad-kind = Die Art muss native oder data sein.
appbuilder.issue.name-not-key = Name und Beschreibung müssen Übersetzungsschlüssel sein, die mit app. beginnen, kein Klartext.
appbuilder.issue.bad-arch = Das Feld arch muss x86_64 oder aarch64 sein.
appbuilder.issue.no-icon = Die im Manifest genannte Symboldatei fehlt.
appbuilder.issue.no-payload = Der Ordner payload fehlt oder ist leer (die gebauten Dateien so hineinlegen, wie sie installiert werden).
appbuilder.issue.exec-missing = Das in exec genannte Programm liegt nicht in payload.
appbuilder.issue.bad-network = network muss none, ask, vpn-only oder allowed sein.
appbuilder.issue.missing-section = Der Abschnitt [{ $section }] fehlt im Manifest.
appbuilder.error.io = Eine Datei konnte nicht gelesen oder geschrieben werden.
appbuilder.error.key = Der Entwicklerschlüssel konnte nicht erstellt oder gelesen werden.
appbuilder.error.pack = Das Paket konnte nicht gebaut werden.
appbuilder.error.verify = Das gebaute Paket hat die Signaturprüfung nicht bestanden; es wurde gelöscht.
appbuilder.error.not-checked = Bitte zuerst das Projekt prüfen und das Paket bauen.
appbuilder.error.no-launcher = Der Startdienst ist in dieser Sitzung nicht verfügbar.
appbuilder.error.refused = Das System hat das Paket abgelehnt: Der Schlüssel ist auf diesem Gerät nicht vertrauenswürdig oder das Recht fehlt.
