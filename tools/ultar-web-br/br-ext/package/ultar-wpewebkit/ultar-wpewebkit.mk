ULTAR_WPEWEBKIT_VERSION = 2.54.3
ULTAR_WPEWEBKIT_SITE = https://wpewebkit.org/releases
ULTAR_WPEWEBKIT_SOURCE = wpewebkit-$(ULTAR_WPEWEBKIT_VERSION).tar.xz
ULTAR_WPEWEBKIT_INSTALL_STAGING = YES
ULTAR_WPEWEBKIT_LICENSE = LGPL-2.1+, BSD-2-Clause
ULTAR_WPEWEBKIT_CMAKE_BACKEND = ninja
ULTAR_WPEWEBKIT_DEPENDENCIES = host-gperf host-python3 host-ruby host-unifdef \
	libglib2 harfbuzz icu jpeg libepoxy libgcrypt libsoup3 libtasn1 libxkbcommon \
	libxml2 libxslt libpng sqlite webp zlib fontconfig freetype woff2 \
	gstreamer1 gst1-plugins-base gst1-plugins-bad libegl libgles libdrm
ULTAR_WPEWEBKIT_CONF_ENV = WK_USE_CCACHE=NO
ULTAR_WPEWEBKIT_BUILD_ENV = WK_USE_CCACHE=NO
ULTAR_WPEWEBKIT_CONF_OPTS = \
	-DPORT=WPE \
	-DCMAKE_BUILD_TYPE=Release \
	-DENABLE_WPE_PLATFORM=ON \
	-DENABLE_WPE_PLATFORM_HEADLESS=ON \
	-DENABLE_WPE_PLATFORM_DRM=OFF \
	-DENABLE_WPE_PLATFORM_WAYLAND=OFF \
	-DENABLE_WPE_LEGACY_API=OFF \
	-DENABLE_WPE_QT_API=OFF \
	-DENABLE_API_TESTS=OFF \
	-DENABLE_LAYOUT_TESTS=OFF \
	-DENABLE_MINIBROWSER=OFF \
	-DENABLE_COG=OFF \
	-DENABLE_DOCUMENTATION=OFF \
	-DENABLE_INTROSPECTION=OFF \
	-DENABLE_JOURNALD_LOG=OFF \
	-DENABLE_BUBBLEWRAP_SANDBOX=OFF \
	-DENABLE_WEBDRIVER=OFF \
	-DENABLE_SPELLCHECK=OFF \
	-DENABLE_SPEECH_SYNTHESIS=OFF \
	-DENABLE_GAMEPAD=OFF \
	-DENABLE_WEB_RTC=OFF \
	-DENABLE_WEBXR=OFF \
	-DENABLE_THUNDER=OFF \
	-DUSE_ATK=OFF \
	-DUSE_FLITE=OFF \
	-DUSE_GBM=OFF \
	-DUSE_LIBDRM=OFF \
	-DUSE_LIBBACKTRACE=OFF \
	-DUSE_LIBHYPHEN=OFF \
	-DUSE_AVIF=OFF \
	-DUSE_JPEGXL=OFF \
	-DUSE_LCMS=OFF \
	-DUSE_WOFF2=ON \
	-DUSE_SYSPROF_CAPTURE=OFF \
	-DUSE_GSTREAMER_GL=OFF \
	-DUSE_GSTREAMER_TRANSCODER=OFF \
	-DENABLE_MEDIA_STREAM=OFF \
	-DENABLE_MEDIA_RECORDER=OFF
$(eval $(cmake-package))
