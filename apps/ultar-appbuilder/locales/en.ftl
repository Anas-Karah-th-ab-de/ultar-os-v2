app.appbuilder.name = App-Builder
app.appbuilder.desc = Check an app project, package it as a .uap signed with your key, and install it on this device for testing.
appbuilder.project = Project folder
appbuilder.check = Check
appbuilder.build = Build package
appbuilder.install = Install for testing
appbuilder.state.idle = Choose a project folder with ultar-app.toml and a payload folder.
appbuilder.state.busy = Working…
appbuilder.state.checked = Project is fine: { $id } { $version }
appbuilder.state.built = Ready: { $path }
appbuilder.state.installed = { $id } was installed on this device.
appbuilder.key.title = Developer key
appbuilder.key.id = Key id: { $id }
appbuilder.key.public = Public key: { $key }
appbuilder.key.trust = For this device to accept your packages, an administrator must add this public key as { $file } to the trusted keys.
appbuilder.issue.no-manifest = There is no ultar-app.toml in the folder.
appbuilder.issue.manifest-damaged = The manifest cannot be understood (invalid TOML).
appbuilder.issue.bad-id = The id must be <publisher>.<app> in lowercase Latin letters, digits and hyphens, and the publisher must match the publisher field.
appbuilder.issue.bad-version = The version must look like 1.2.3.
appbuilder.issue.no-publisher = The publisher field is missing.
appbuilder.issue.bad-kind = The kind must be native or data.
appbuilder.issue.name-not-key = Name and description must be translation keys starting with app., not plain text.
appbuilder.issue.bad-arch = The arch field must be x86_64 or aarch64.
appbuilder.issue.no-icon = The icon file named in the manifest does not exist.
appbuilder.issue.no-payload = The payload folder is missing or empty (put the built files in it, laid out as installed).
appbuilder.issue.exec-missing = The program named in exec is not inside payload.
appbuilder.issue.bad-network = network must be none, ask, vpn-only or allowed.
appbuilder.issue.missing-section = The section [{ $section }] is missing from the manifest.
appbuilder.error.io = A file could not be read or written.
appbuilder.error.key = The developer key could not be created or read.
appbuilder.error.pack = The package could not be built.
appbuilder.error.verify = The built package failed its signature check; it was deleted.
appbuilder.error.not-checked = Check the project and build the package first.
appbuilder.error.no-launcher = The launcher service is not available in this session.
appbuilder.error.refused = The system refused the package: the key is not trusted on this device or the right is missing.
