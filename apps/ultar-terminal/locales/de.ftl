# ultar-terminal – Texte des Terminals (Arabisch ist die Vorlage)
app.terminal.name = Terminal
app.terminal.desc = Befehle auf Arabisch und Englisch für deine Dateien und die Programme des Systems.
term.output = Ausgabe des Terminals
term.command = Befehl
term.run = Ausführen
term.stop = Anhalten
term.welcome = Ultar-Terminal – help (oder مساعدة) zeigt die Befehle.
term.help.title = Befehle (Arabisch oder Englisch):
term.help.ls = ls | اعرض [Ordner]          Inhalt eines Ordners
term.help.cd = cd | انتقل [Ordner]         in einen Ordner wechseln (~ = Persönlicher Ordner)
term.help.pwd = pwd | أين                  der aktuelle Ordner
term.help.cat = cat | اقرأ Datei           eine Textdatei zeigen
term.help.echo = echo | اطبع Text          Text ausgeben
term.help.mkdir = mkdir | أنشئ Ordner      neuer Ordner
term.help.rm = rm | احذف [-r] Pfad         Datei löschen (Ordner mit -r)
term.help.cp = cp | انسخ von nach          Datei oder Ordner kopieren
term.help.mv = mv | انقل von nach          verschieben oder umbenennen
term.help.clear = clear | امسح             Bildschirm leeren
term.help.date = date | التاريخ            Datum und Uhrzeit (UTC)
term.help.whoami = whoami | من             der Benutzer
term.help.uname = uname | النظام           Name und Version des Systems
term.help.history = history | السجل        frühere Befehle
term.help.env = env | بيئة                 Umgebungsvariablen
term.help.exit = exit | خروج               Terminal schließen
term.help.programs = Auch jedes Programm des Systems mit seinem Namen, z. B. ulog. Strg+C hält es an.
term.unknown = Unbekannter Befehl: „{name}“. Tippe help.
term.missing = Nicht gefunden: {path}
term.denied = Nicht erlaubt: {path}
term.exists = Gibt es schon: {path}
term.not_dir = Kein Ordner: {path}
term.is_dir = Ein Ordner (mit -r): {path}
term.not_empty = Der Ordner ist nicht leer: {path}
term.failed = Fehlgeschlagen: {path} ({reason})
term.usage = Aufruf: {usage}
term.binary = {path}: eine Binärdatei, nicht als Text gezeigt
term.exit_code = Das Programm endete mit Code {code}
term.start_failed = „{name}“ ließ sich nicht starten: {reason}
term.stopped = Das Programm wurde angehalten
term.busy = Ein Programm läuft; Strg+C hält es an.
term.empty = (leer)
