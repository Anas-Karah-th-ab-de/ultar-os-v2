# ultar-auth – Deutsch
auth.cli.usage = Aufruf: ultar-authd --dir ORDNER passwd BENUTZER [--display NAME] [--pin] – das Geheimnis wird zweimal von der Standardeingabe gelesen
auth.cli.done = Das Geheimnis wurde gespeichert.
auth.cli.mismatch = Die beiden Eingaben stimmen nicht überein.
auth.cli.rejected = Abgelehnt: ein Kennwort hat mindestens 4 Zeichen, eine PIN 4 bis 12 Ziffern, ein Benutzername kleine lateinische Buchstaben.
auth.cli.failed = Die Konten konnten nicht gespeichert werden: {detail}
auth.daemon.unusable = Die Kontodatei ist beschädigt oder unlesbar; niemand kann sich anmelden, bis ein Verwalter sie repariert (ultar-authd passwd).
